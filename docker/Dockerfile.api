# ── Stage 1 : build ──────────────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

RUN apk add --no-cache openssl

COPY package*.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/database/package.json ./packages/database/
COPY apps/api/package.json ./apps/api/

# --ignore-scripts : le schema n'est pas encore là, on lance prisma generate manuellement après
RUN npm ci --workspaces --include-workspace-root --ignore-scripts

COPY packages/ ./packages/
COPY apps/api/ ./apps/api/

# Générer le client Prisma (schema disponible maintenant)
RUN cd packages/database && npx prisma generate

# Compiler l'API
RUN cd apps/api && npx tsc

# ── Stage 2 : run ─────────────────────────────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app

RUN apk add --no-cache openssl

ENV NODE_ENV=production

COPY package*.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/database/package.json ./packages/database/
COPY apps/api/package.json ./apps/api/

# --ignore-scripts : le client Prisma est déjà généré dans le stage builder
# et copié via COPY --from=builder, pas besoin de le regénérer ici
RUN npm ci --workspaces --include-workspace-root --omit=dev --ignore-scripts

# Copier le build
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY packages/database/prisma ./packages/database/prisma
# shared est résolu via symlink npm workspace → packages/shared ; copier les fichiers compilés
COPY --from=builder /app/packages/shared/src ./packages/shared/src

EXPOSE 3001

# Migrations + démarrage
CMD ["sh", "-c", "npx prisma migrate deploy --schema=packages/database/prisma/schema.prisma && node apps/api/dist/main.js"]
